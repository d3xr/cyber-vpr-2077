# Copy to scripts/deploy.env (gitignored) and fill with REAL infra values.
# deploy.sh sources this file. None of these are committed — public repo.
#
#   cp scripts/deploy.env.example scripts/deploy.env
#   $EDITOR scripts/deploy.env
#
# Real production values are documented in the private operator note
# (handed off separately, NOT in this repo).

CVPR_DEPLOY_SERVER="root@HOST_IP"      # ssh target
CVPR_DEPLOY_DOMAIN="app.example.com"   # public domain
CVPR_DEPLOY_IP="HOST_IP"               # IP for curl --resolve (DNS-independent)
CVPR_WEBROOT="/var/www/app"            # nginx static root
CVPR_APPDIR="/opt/app"                 # backend dir (contains server/)
CVPR_SERVICE="app"                     # systemd unit name
